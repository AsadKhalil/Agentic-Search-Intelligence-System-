# ---------------------------------------------------------------------------
# Everything runs offline with these defaults. Copy to .env only to change them.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- DataForSEO ------------------------------------------------------------
# true  -> fixtures in app/tools/fixtures/, no network, no credentials (default)
# false -> real HTTP against api.dataforseo.com with the credentials below
MOCK_DATAFORSEO=true
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com

# Optional: route google_serp through SerpApi instead of DataForSEO. Volume/difficulty
# and the ChatGPT answer have no SerpApi equivalent and keep using the transport above,
# so with MOCK_DATAFORSEO=true a run mixes real rankings with fixture metrics --
# /health and the run config say so. Leave empty to use DataForSEO for all three.
SERPAPI_API_KEY=
# Artificial per-call delay for the mock, in milliseconds. 0 = instant.
MOCK_LATENCY_MS=0

# --- LLM -------------------------------------------------------------------
# Empty -> ScriptedToolCallingLLM: deterministic, offline, implements bind_tools().
# Set a key to route planning and analysis through OpenAI instead.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=45

# --- Timeouts --------------------------------------------------------------
# Global per-request timeout for DataForSEO calls.
HTTP_TIMEOUT_SECONDS=20
# chat_gpt/llm_responses/live is documented at up to 120s, so it gets its own
# budget; the 20s global would time out on every call.
CHATGPT_TIMEOUT_SECONDS=130

# --- Retry -----------------------------------------------------------------
# Total attempts including the first: 4 = 1 try + 3 retries.
RETRY_MAX_ATTEMPTS=4
# delay = random(0, min(RETRY_MAX_DELAY, BASE * 2**attempt))   -- full jitter
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=8
RETRY_JITTER=true

# --- App -------------------------------------------------------------------
DATABASE_URL=sqlite:///./agentic_search.db
LOG_LEVEL=INFO
# json    -> one structured object per line, for grepping with jq
# console -> human-readable, for local development
LOG_FORMAT=json
# Upper bound on distinct logical queries one run may investigate.
MAX_PLANNED_QUERIES=8
